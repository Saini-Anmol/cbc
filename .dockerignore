# NOTE: .dockerignore patterns are matched from the context ROOT.
# A bare "*.xlsx" does NOT match "data/input/foo.xlsx" — use "**/*.xlsx".
# Getting this wrong baked 1.3 GB of demand workbooks into the image.

# Secrets — NEVER bake into the image (injected at runtime via --env-file / -e)
.env
.env.*

# Virtualenv / caches
myenv/
**/__pycache__/
**/*.pyc
.pytest_cache/

# VCS & editor
.git/
.gitignore
.claude/
.vscode/
.idea/
**/.DS_Store

# Data: the cloud path reads demand + masters from the DB and writes results to
# /app/output (created in the Dockerfile). No local data belongs in the image.
data/
docker_output/
sap_prod_output/
not_used/

# Any stray spreadsheets / dumps anywhere in the tree
**/*.xlsx
**/*.xls
**/*.csv
**/*.db

# Docs / scratch / logs
approach/*.pdf
scratch_*.py
**/*.log

# ── Engine-required REFERENCE files (read from the FILESYSTEM on every run, not the DB) ──
# These MUST ship in the image or the cloud engine silently falls back (INCH_HIST_LOCK,
# dominant-inch band, per-SKU building CT) and DIVERGES from the local plan. Re-included
# past the data/ + **/*.xlsx + **/*.csv excludes above (last-matching pattern wins). Only
# these 3 small files (≈10/10/24 KB) — NOT their parent dirs (analysis_aug is 275 MB).
!data/analysis_aug/machine_inch_dominant_aug.xlsx
!data/analysis_aug/machine_inch_dominant_4months_Apr-Jul.xlsx
!data/input/Cycle_time_Building.xlsx
