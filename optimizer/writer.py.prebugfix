"""optimizer/writer.py — recover a physical press<->SKU assignment from the
CP-SAT COUNT solution and VERIFY it against the EXACT mould-feasibility audit.

WHY THIS EXISTS
    optimizer/model.py models curing by per-SKU press COUNTS  n[(sku, t)]  = how
    many presses cure `sku` at shift t — NOT which physical press. That is a
    COUNT-RELAXATION of the real per-shift bipartite constraint:
        * each RUNNING press needs 2 eligible FREE moulds for its SKU, and
        * a mould serves exactly ONE press per shift (contention).
    The model only approximates that with (a) the total press-count cap
    (sum n <= n_press), (b) the per-SKU domain cap min(mould_pairs, elig_presses),
    and (c) a union-find shared-mould component cap. None of those is the exact
    bipartite b-matching, so the counts can be INFEASIBLE to realise physically.

    This module closes the loop: it recovers an actual {press: sku} per shift and
    runs the SAME exact bipartite audit that scratch_mould_audit.py enforces on the
    greedy engine's output. A PASS proves the count-relaxation was tight for this
    plan; a FAIL quantifies exactly how loose it is (which shifts / SKUs, by how
    many mould-slots or presses).

TWO INDEPENDENT FEASIBILITY LAYERS (both must hold for a shift to be realisable):
  1. PRESS ELIGIBILITY — can we hand each SKU s exactly n[s,t] DISTINCT presses,
     each eligible for s (press in sku_presses[s]), no press serving two SKUs?
     The model's only guard here is the loose total-count cap sum n <= n_press;
     a press eligible for just a few SKUs can still be over-subscribed. Solved as
     a bipartite matching (demand-nodes x presses) via maximum_bipartite_matching.
  2. MOULD FEASIBILITY — given the SAME counts, split each serving press into 2
     slots, connect each slot to its SKU's eligible moulds, require a PERFECT
     matching of all slots to distinct moulds. This depends ONLY on the counts
     n[s,t] (moulds are eligible per-SKU, not per-press), so it is identical to
     the scratch_mould_audit.py check applied to the recovered press->sku map.
     Exact via scipy.sparse.csgraph.maximum_bipartite_matching (no greedy
     false-positives).

The mould eligibility used here mirrors scratch_mould_audit.py EXACTLY: the base
`load_mould_eligibility()` map (carried in mi.sku_moulds) PLUS the Day-0 mounted
(mould, SKU) pairs folded in from mi.press_init_moulds / mi.press_init_sku (the
scheduler treats those orphan mounted moulds as eligible, so a fair audit must
too — otherwise a running press is falsely flagged short by a slot).

Interfaces used (STABLE):
    optimizer.data.load_model_inputs -> mi (presses, sku_presses, press_allowed_skus,
        sku_moulds, mould_pairs, press_init_sku, press_init_moulds, ...)
    optimizer.model.build_and_solve  -> sol; sol['plan']['n'] = {(sku,t): count};
        sol['meta']['W'] = #shifts.
"""
from __future__ import annotations

import numpy as np
from scipy.sparse import csr_matrix
from scipy.sparse.csgraph import maximum_bipartite_matching
from ortools.graph.python import min_cost_flow as _mcf


# ----------------------------------------------------------------------------
# Mould eligibility — reproduce scratch_mould_audit.py's fold of Day-0 mounted
# moulds into the per-SKU eligibility pool (so the audit is the SAME fair test).
# ----------------------------------------------------------------------------
def _mould_eligibility(mi) -> dict:
    """sku -> set(mould_id), = mi.sku_moulds + Day-0 mounted (press_init_moulds)."""
    sku_moulds = {s: set(v) for s, v in mi.sku_moulds.items()}
    for p, s in mi.press_init_sku.items():
        if not s:                                   # idle press at t0 -> nothing to fold
            continue
        for md in mi.press_init_moulds.get(p, ()):  # orphan moulds mounted at Day 0
            md = str(md).strip()
            if md and md.lower() != "nan":
                sku_moulds.setdefault(s, set()).add(md)
    return sku_moulds


def _bipartite_match(rows, cols, n_rows, n_cols):
    """Max bipartite matching. Returns match array (len n_rows): matched col or -1."""
    if n_rows == 0:
        return np.empty(0, dtype=int)
    if not rows or n_cols == 0:                     # no edges -> nothing matchable
        return np.full(n_rows, -1, dtype=int)
    graph = csr_matrix((np.ones(len(rows), dtype=int), (rows, cols)),
                       shape=(n_rows, n_cols))
    return maximum_bipartite_matching(graph, perm_type="column")


# ----------------------------------------------------------------------------
# CONTINUITY press-eligibility matching (Layer 1, CONTINUITY-PRESERVING).
#
# The old recovery re-solved press identity INDEPENDENTLY every shift with a fresh
# maximum_bipartite_matching, so scipy's column-perm returned an essentially
# arbitrary/rotated set of presses for a SKU that needs the SAME count shift-to-shift.
# Every reshuffle was booked downstream (output_full) as a physical curing CO -> the
# 2,891-vs-364 explosion (see scratchpad/co_continuity_rca.txt).
#
# This version CARRIES each press's set-up SKU from shift t-1 to t: a press KEEPS its
# SKU as long as that SKU still needs it (no CO, and it is NEVER displaced), and only
# the FEW slots left over (a SKU's count grew, or a press went idle) are filled from the
# free pool — each such fill is exactly one real, counted CO. The audit is preserved
# EXACTLY because:
#   * the audit's per-shift press-shortfall is still scored with the exact MAXIMUM
#     bipartite matching (kept verbatim below), independent of the continuity choice, so
#     its PASS/FAIL is byte-identical to the old recovery, and
#   * mould feasibility (Layer 2) depends ONLY on the per-SKU counts n[s,t] (moulds are
#     eligible per-SKU, not per-press), so it is untouched by WHICH press serves.
# Keeping each press on its set-up SKU (rather than re-solving identity every shift) is
# the whole fix: the old code let a fresh maximum matching rotate the serving presses.
# ----------------------------------------------------------------------------
def recover_assignment(sol, mi, init_setup=None, return_extra=False):
    """Recover a CONTINUITY-preserving physical press->SKU assignment per shift.

    Args:
        init_setup : {press: sku} the SKU each press was physically set up for at the
                     START of this window (carried across the rolling window seam).
                     None -> seed from mi.press_init_sku (Day-0 mounted SKU). A press
                     with no set-up SKU carries None.
        return_extra : if True also return (co_by_shift, setup_by_shift) so the driver
                     can (a) split cured over ONLY the producing presses and (b) carry
                     the set-up state across the next window seam.

    Returns (default): assignment, infeasible
        assignment : {t: {press: sku}}  every press ASSIGNED to a SKU this shift
                     (producing + newly-onboarded), a press appears iff matched.
        infeasible : list of (t, sku, shortfall, reason) — reason "press" (not enough
                     DISTINCT eligible presses; == the exact maximum-matching shortfall)
                     or "mould" (not enough disjoint eligible moulds; 2 slots == 1 press).
    If return_extra: assignment, infeasible, co_by_shift, setup_by_shift where
        co_by_shift[t]    = set of presses newly ONBOARDED this shift (in CO -> produce
                            0 this shift; the model's co[s,t] presses), and
        setup_by_shift[t] = {press: sku} set-up state AFTER shift t (persists across
                            idle shifts; used to seed the next window).
    """
    plan = sol["plan"]
    n_by = plan["n"]                                # {(sku, t): count}
    W = sol["meta"]["W"]

    presses = list(mi.presses)
    press_idx = {p: i for i, p in enumerate(presses)}
    n_presses = len(presses)
    sku_moulds = _mould_eligibility(mi)
    # eligible presses per SKU, as sorted index lists (deterministic).
    sku_elig_idx = {}
    for s in mi.sku_presses:
        sku_elig_idx[s] = sorted(press_idx[p] for p in mi.sku_presses.get(s, ()) if p in press_idx)

    # set-up carry state: press-index -> sku (or None). Seed from init_setup / Day-0.
    setup = [None] * n_presses
    seed = init_setup if init_setup is not None else mi.press_init_sku
    for p, s in (seed or {}).items():
        i = press_idx.get(p)
        if i is not None and s:
            setup[i] = s

    assignment: dict = {}
    infeasible: list = []
    co_by_shift: dict = {}
    setup_by_shift: dict = {}

    for t in range(W):
        # required press count per SKU this shift
        req = {}
        for (s, tt), c in n_by.items():
            if tt == t and c > 0:
                req[s] = req.get(s, 0) + int(c)

        assign_t: dict = {}
        assignment[t] = assign_t
        co_presses: set = set()
        co_by_shift[t] = co_presses

        if req:
            skus_sorted = sorted(req)

            # ================= INFEASIBILITY REPORT (for the audit) =================
            # Layer 1 press-eligibility is scored with the EXACT MAXIMUM bipartite
            # matching (unchanged from the original recovery) so the audit's PASS/FAIL
            # and per-shift press-shortfall are IDENTICAL to before — the continuity
            # assignment below never weakens the audit, it only changes WHICH press
            # serves. (Layer 2 mould is likewise unchanged, count-based.)
            row_sku = []
            arows, acols = [], []
            for s in skus_sorted:
                elig = sku_elig_idx.get(s, ())
                for _ in range(req[s]):
                    r = len(row_sku)
                    row_sku.append(s)
                    for ci in elig:
                        arows.append(r); acols.append(ci)
            amatch = _bipartite_match(arows, acols, len(row_sku), n_presses)
            press_short: dict = {}
            for r, s in enumerate(row_sku):
                if amatch[r] == -1:
                    press_short[s] = press_short.get(s, 0) + 1
            for s, short in sorted(press_short.items()):
                infeasible.append((t, s, short, "press"))

            # ================= CONTINUITY ASSIGNMENT (for the rows) =================
            # Exact LEXICOGRAPHIC min-cost max-flow: (1) MAXIMISE filled press-slots so
            # every SKU gets its full press count -> the shift's cured is never lost
            # (conservation) and never concentrated onto too few presses (occupancy
            # stays <= 100%); (2) among all maximum assignments, MINIMISE onboards -> a
            # press KEEPS its set-up SKU (cost 0) and only moves when the counts force it
            # (cost 1), which collapses the physical CO count. This replaces the old
            # independent per-shift matching that rotated presses arbitrarily. A press
            # physically set up for s (incl. a Day-0 running press folded into mould
            # eligibility) may keep s even if absent from the strict sku_presses list;
            # only a MOVE onto a NEW SKU requires sku_presses eligibility.
            smcf = _mcf.SimpleMinCostFlow()
            SRC = 0
            sku_node = {s: 1 + n_presses + j for j, s in enumerate(skus_sorted)}
            SINK = 1 + n_presses + len(skus_sorted)
            T = sum(req.values())
            BIG = 10 * (n_presses + 1)                # >> any onboard cost -> real fills win
            for pi in range(n_presses):               # source -> each press (used <= once)
                smcf.add_arc_with_capacity_and_unit_cost(SRC, 1 + pi, 1, 0)
            for s in skus_sorted:                      # press -> SKU (cost 0 keep / 1 move)
                sn = sku_node[s]
                cand = set(sku_elig_idx.get(s, ()))
                cand.update(pi for pi in range(n_presses) if setup[pi] == s)
                for pi in sorted(cand):
                    smcf.add_arc_with_capacity_and_unit_cost(
                        1 + pi, sn, 1, 0 if setup[pi] == s else 1)
                smcf.add_arc_with_capacity_and_unit_cost(sn, SINK, req[s], 0)
            # high-cost bypass so a rare press-shortfall drains instead of infeasing.
            smcf.add_arc_with_capacity_and_unit_cost(SRC, SINK, T, BIG)
            smcf.set_node_supply(SRC, T)
            smcf.set_node_supply(SINK, -T)
            if smcf.solve() == smcf.OPTIMAL:
                lo, hi = 1 + n_presses, SINK           # sku-node id range
                for arc in range(smcf.num_arcs()):
                    if smcf.flow(arc) <= 0:
                        continue
                    u, v = smcf.tail(arc), smcf.head(arc)
                    if 1 <= u <= n_presses and lo <= v < hi:   # a press->SKU assignment
                        pi = u - 1; s = skus_sorted[v - lo]; p = presses[pi]
                        assign_t[p] = s
                        if setup[pi] != s:             # moved onto a new SKU -> CO this shift
                            co_presses.add(p)

            # ---------- Layer 2: EXACT MOULD b-matching (UNCHANGED, count-based) ----
            # 2 slots per required press; each slot -> its SKU's eligible moulds;
            # perfect matching to DISTINCT moulds required (a mould serves 1 press).
            mset = set()
            for s in req:
                mset.update(sku_moulds.get(s, ()))
            moulds = sorted(mset)
            midx = {md: i for i, md in enumerate(moulds)}

            slot_sku = []
            srows, scols = [], []
            for s in skus_sorted:
                sm = [midx[md] for md in sku_moulds.get(s, ()) if md in midx]
                for _ in range(2 * req[s]):
                    r = len(slot_sku)
                    slot_sku.append(s)
                    for ci in sm:
                        srows.append(r); scols.append(ci)
            smatch = _bipartite_match(srows, scols, len(slot_sku), len(moulds))
            mould_short: dict = {}
            for r, s in enumerate(slot_sku):
                if smatch[r] == -1:
                    mould_short[s] = mould_short.get(s, 0) + 1
            for s, short in sorted(mould_short.items()):
                infeasible.append((t, s, short, "mould"))

        # ---- advance set-up state: assigned presses adopt their SKU; idle presses
        #      RETAIN their prior set-up (a press idle for a shift is still mounted for
        #      its last SKU, so resuming it is NOT a changeover). ----
        for p, s in assign_t.items():
            setup[press_idx[p]] = s
        setup_by_shift[t] = {presses[i]: setup[i] for i in range(n_presses)
                             if setup[i] is not None}

    if return_extra:
        return assignment, infeasible, co_by_shift, setup_by_shift
    return assignment, infeasible


# ----------------------------------------------------------------------------
# audit_solution — run the recovery across all shifts and summarise PASS/FAIL.
# ----------------------------------------------------------------------------
def audit_solution(sol, mi):
    """Recover + exact-audit every shift. Returns a PASS/FAIL summary dict."""
    assignment, infeasible = recover_assignment(sol, mi)
    W = sol["meta"]["W"]
    bad_shifts = sorted({t for (t, _, _, _) in infeasible})
    return {
        "feasible_shifts":   W - len(bad_shifts),
        "infeasible_shifts": len(bad_shifts),
        "overall":           "PASS" if not infeasible else "FAIL",
        # worst first, by shortfall magnitude
        "violations":        sorted(infeasible, key=lambda v: -v[2]),
        "assignment":        assignment,
    }


# ----------------------------------------------------------------------------
# CLI — solve a 10-day August window and audit it.
# ----------------------------------------------------------------------------
if __name__ == "__main__":
    from optimizer.data import load_model_inputs
    from optimizer.model import build_and_solve

    mi = load_model_inputs()                        # month = bc_config (Aug set)
    print("Inputs:", mi.summary())
    print("Solving a 10-day August window (day_start=1, workers=8, det_time=60s, seed=1)...")
    sol = build_and_solve(mi, day_start=1, n_days=10,
                          det_time_s=60.0, seed=1, workers=8)
    print(f"  solve status={sol['status']}  cured={sol['cured']:,}  "
          f"n_co={sol['n_co']}  gap={sol.get('gap')}  wall={sol['wall_s']}s")
    if "plan" not in sol:
        print("  no solution to audit (status not OPTIMAL/FEASIBLE) — abort.")
        raise SystemExit(1)

    res = audit_solution(sol, mi)
    W = sol["meta"]["W"]
    print("\n===== EXACT MOULD-FEASIBILITY AUDIT (count-relaxation gate) =====")
    print(f"RESULT: {res['overall']}")
    print(f"shifts audited     : {W}")
    print(f"feasible shifts    : {res['feasible_shifts']}")
    print(f"infeasible shifts  : {res['infeasible_shifts']}")

    viol = res["violations"]
    if not viol:
        print("Every shift's press-count vector is PHYSICALLY REALISABLE "
              "(distinct eligible presses + disjoint 2-mould assignment). "
              "The count-relaxation is TIGHT for this plan.")
    else:
        n_press_v = sum(1 for v in viol if v[3] == "press")
        n_mould_v = sum(1 for v in viol if v[3] == "mould")
        tot_press = sum(v[2] for v in viol if v[3] == "press")
        tot_mould = sum(v[2] for v in viol if v[3] == "mould")
        print(f"violations         : {len(viol)}  "
              f"(press={n_press_v} totalling {tot_press} presses, "
              f"mould={n_mould_v} totalling {tot_mould} mould-slots ~= "
              f"{tot_mould/2:.1f} presses)")
        print("\nworst violations (shift t, SKU, shortfall, reason):")
        for t, s, short, reason in viol[:12]:
            day = t // 3 + 1
            shift = "ABC"[t % 3]
            unit = "presses" if reason == "press" else "mould-slots"
            print(f"    t={t:>3} (day {day:>2} shift {shift})  {s}  "
                  f"short {short} {unit}  [{reason}]")
